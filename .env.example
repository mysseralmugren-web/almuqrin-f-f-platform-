# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time first-administrator setup token (server only, at least 32 random characters)
BOOTSTRAP_TOKEN=

# Signed document verification QR (server only, at least 32 random characters)
DOCUMENT_QR_SECRET=

# Optional AI and integration secrets (server only)
# Configure one AI provider. OPENAI_API_KEY enables the invoice/document
# analyzer and the advertising creative generator; never expose it as VITE_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LOVABLE_API_KEY=
WEBSITE_WEBHOOK_SECRET=
WEBSITE_CAPTCHA_SECRET=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_TOKEN=
EMAIL_API_KEY=

# Advertising Manager (server only; never prefix these with VITE_)
META_AD_ACCOUNT_ID=
META_AD_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
TIKTOK_ADVERTISER_ID=
TIKTOK_AD_ACCESS_TOKEN=
X_AD_ACCOUNT_ID=
X_ADS_BEARER_TOKEN=
# Approved X Ads analytics endpoint for this account/integration.
X_ADS_ANALYTICS_URL=

# Daftra ERP integration (server only; never prefix these with VITE_)
DAFTRA_BASE_URL=
DAFTRA_API_KEY=