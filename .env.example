# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time first-administrator setup token (server only, at least 32 random characters)
BOOTSTRAP_TOKEN=

# Signed document verification QR (server only, at least 32 random characters)
DOCUMENT_QR_SECRET=

# Optional AI and integration secrets (server only)
# Configure one AI provider. OPENAI_API_KEY enables the invoice/document
# analyzer through the official Responses API; never expose it as VITE_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LOVABLE_API_KEY=
WEBSITE_WEBHOOK_SECRET=
WEBSITE_CAPTCHA_SECRET=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_TOKEN=
EMAIL_API_KEY=
